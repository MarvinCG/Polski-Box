{"id":"u01","es":"Saludos y cortesía","pl":"Powitania i zwroty grzecznościowe","wk":1,
"items":[
{"pl":"Dzień dobry","ipa":"dʑɛɲ ˈdɔbrɨ","es":"Buenos días / Buenas tardes","n":"Formal. Sirve desde la mañana hasta el atardecer."},
{"pl":"Dobry wieczór","ipa":"ˈdɔbrɨ ˈvʲɛtʂur","es":"Buenas noches (al llegar)","n":"Saludo formal por la noche."},
{"pl":"Cześć","ipa":"tʂɛɕtɕ","es":"Hola / Chao","n":"Informal: amigos, familia, gente joven. Sirve para saludar y para despedirse."},
{"pl":"Hej","ipa":"xɛj","es":"Hola (muy informal)"},
{"pl":"Do widzenia","ipa":"dɔ viˈdzɛɲa","es":"Adiós","n":"Formal: tiendas, oficinas, desconocidos."},
{"pl":"Na razie","ipa":"na ˈraʑɛ","es":"Hasta luego","n":"Informal."},
{"pl":"Pa!","ipa":"pa","es":"¡Chao!","n":"Muy informal; a menudo «Pa pa!»."},
{"pl":"Do zobaczenia","ipa":"dɔ zɔbaˈtʂɛɲa","es":"Nos vemos"},
{"pl":"Do jutra!","ipa":"dɔ ˈjutra","es":"¡Hasta mañana!"},
{"pl":"Dobranoc","ipa":"dɔˈbranɔts","es":"Buenas noches (al despedirse o ir a dormir)"},
{"pl":"Proszę","ipa":"ˈprɔʂɛ","es":"Por favor / Aquí tiene / Adelante","n":"Palabra comodín: también «de nada» y, como pregunta («Proszę?»), «¿perdón?»."},
{"pl":"Poproszę…","ipa":"pɔˈprɔʂɛ","es":"¿Me da…?, por favor","n":"La forma normal de pedir algo: «Poproszę kawę» (un café, por favor)."},
{"pl":"Dziękuję","ipa":"dʑɛŋˈkujɛ","es":"Gracias"},
{"pl":"Dzięki","ipa":"ˈdʑɛŋki","es":"Gracias (informal)"},
{"pl":"Dziękuję bardzo","ipa":"dʑɛŋˈkujɛ ˈbardzɔ","es":"Muchas gracias"},
{"pl":"Nie ma za co","ipa":"ɲɛ ma ˈza tsɔ","es":"De nada"},
{"pl":"Przepraszam","ipa":"pʂɛˈpraʂam","es":"Perdón / Disculpe","n":"Para pedir disculpas y para llamar la atención de alguien."},
{"pl":"Tak","ipa":"tak","es":"Sí"},
{"pl":"Nie","ipa":"ɲɛ","es":"No"},
{"pl":"Dobrze","ipa":"ˈdɔbʐɛ","es":"Bien / De acuerdo"},
{"pl":"Jak się masz?","ipa":"jak ɕɛ maʂ","es":"¿Cómo estás?","n":"Informal."},
{"pl":"Co słychać?","ipa":"tsɔ ˈswɨxatɕ","es":"¿Qué tal? / ¿Qué hay de nuevo?"},
{"pl":"Smacznego!","ipa":"smatʂˈnɛɡɔ","es":"¡Buen provecho!"},
{"pl":"Na zdrowie!","ipa":"na ˈzdrɔvʲɛ","es":"¡Salud!","n":"Al brindar y cuando alguien estornuda."},
{"pl":"Miłego dnia!","ipa":"miˈwɛɡɔ dɲa","es":"¡Que tengas buen día!"},
{"pl":"Wszystkiego najlepszego!","ipa":"fʂɨstˈkʲɛɡɔ najlɛpˈʂɛɡɔ","es":"¡Felicidades! / ¡Feliz cumpleaños!"}
],
"ctx":[
{"w":"Ola","pl":"Cześć! Jak się masz?","es":"¡Hola! ¿Cómo estás?"},
{"w":"Tú","pl":"Dobrze, dziękuję. A ty?","es":"Bien, gracias. ¿Y tú?"},
{"w":"Ola","pl":"Też dobrze.","es":"También bien."},
{"w":"Tú","pl":"Przepraszam, muszę iść. Na razie!","es":"Perdón, me tengo que ir. ¡Hasta luego!"},
{"w":"Ola","pl":"Pa! Miłego dnia!","es":"¡Chao! ¡Que tengas buen día!"}
]},

{"id":"u02","es":"Presentarte","pl":"Przedstawianie się","wk":1,
"items":[
{"pl":"Jak masz na imię?","ipa":"jak maʂ na ˈimʲɛ","es":"¿Cómo te llamas?","n":"Informal."},
{"pl":"Mam na imię…","ipa":"mam na ˈimʲɛ","es":"Me llamo…"},
{"pl":"Jestem…","ipa":"ˈjɛstɛm","es":"Soy…","n":"También sirve para presentarte: «Jestem Diego»."},
{"pl":"Jak się pani nazywa?","ipa":"jak ɕɛ ˈpaɲi naˈzɨva","es":"¿Cómo se llama usted? (a una mujer)","n":"A un hombre: «Jak się pan nazywa?»."},
{"pl":"Nazywam się…","ipa":"naˈzɨvam ɕɛ","es":"Me llamo… (nombre y apellido)"},
{"pl":"Miło mi.","ipa":"ˈmiwɔ mi","es":"Mucho gusto."},
{"pl":"Bardzo mi miło.","ipa":"ˈbardzɔ mi ˈmiwɔ","es":"Encantado / Encantada."},
{"pl":"Mnie też.","ipa":"mɲɛ tɛʂ","es":"Igualmente. / A mí también."},
{"pl":"Skąd jesteś?","ipa":"skɔnt ˈjɛstɛɕ","es":"¿De dónde eres?"},
{"pl":"Jestem z Kostaryki.","ipa":"ˈjɛstɛm s kɔstaˈrɨki","es":"Soy de Costa Rica."},
{"pl":"Mieszkam w Kostaryce.","ipa":"ˈmʲɛʂkam f kɔstaˈrɨtsɛ","es":"Vivo en Costa Rica."},
{"pl":"Gdzie mieszkasz?","ipa":"ɡdʑɛ ˈmʲɛʂkaʂ","es":"¿Dónde vives?"},
{"pl":"Mówię po hiszpańsku.","ipa":"ˈmuvʲɛ pɔ xiʂˈpaɲsku","es":"Hablo español."},
{"pl":"Mówię trochę po polsku.","ipa":"ˈmuvʲɛ ˈtrɔxɛ pɔ ˈpɔlsku","es":"Hablo un poco de polaco."},
{"pl":"Uczę się polskiego.","ipa":"ˈutʂɛ ɕɛ pɔlˈskʲɛɡɔ","es":"Estoy aprendiendo polaco."},
{"pl":"Ile masz lat?","ipa":"ˈilɛ maʂ lat","es":"¿Cuántos años tienes?"},
{"pl":"Mam trzydzieści lat.","ipa":"mam tʂɨˈdʑɛɕtɕi lat","es":"Tengo treinta años.","n":"Con 2, 3 y 4 (y 22, 23, 24…) se dice «lata»: «Mam dwadzieścia dwa lata»."},
{"pl":"Czym się zajmujesz?","ipa":"tʂɨm ɕɛ zajˈmujɛʂ","es":"¿A qué te dedicas?"},
{"pl":"Jestem informatykiem.","ipa":"ˈjɛstɛm infɔrmaˈtɨkʲɛm","es":"Soy informático.","n":"Las profesiones van en instrumental: informatyk → informatykiem."},
{"pl":"Pracuję w biurze.","ipa":"praˈtsujɛ v ˈbʲuʐɛ","es":"Trabajo en una oficina."}
],
"ctx":[
{"w":"Ola","pl":"Cześć! Jestem Ola. A ty? Jak masz na imię?","es":"¡Hola! Soy Ola. ¿Y tú? ¿Cómo te llamas?"},
{"w":"Tú","pl":"Mam na imię Diego. Miło mi.","es":"Me llamo Diego. Mucho gusto."},
{"w":"Ola","pl":"Mnie też. Skąd jesteś?","es":"Igualmente. ¿De dónde eres?"},
{"w":"Tú","pl":"Jestem z Kostaryki. Uczę się polskiego.","es":"Soy de Costa Rica. Estoy aprendiendo polaco."},
{"w":"Ola","pl":"Super! Mówisz bardzo dobrze.","es":"¡Genial! Hablas muy bien."},
{"w":"Tú","pl":"Dziękuję, ale mówię tylko trochę po polsku.","es":"Gracias, pero solo hablo un poco de polaco."}
]},

{"id":"u03","es":"Entender y hacerte entender","pl":"Rozmowa: podstawy","wk":1,
"items":[
{"pl":"Nie rozumiem.","ipa":"ɲɛ rɔˈzumʲɛm","es":"No entiendo."},
{"pl":"Rozumiem.","ipa":"rɔˈzumʲɛm","es":"Entiendo."},
{"pl":"Nie wiem.","ipa":"ɲɛ vʲɛm","es":"No sé."},
{"pl":"Słucham?","ipa":"ˈswuxam","es":"¿Perdón? ¿Cómo? / ¿Aló?","n":"Literalmente «escucho». Úsalo si no oíste bien o al contestar el teléfono."},
{"pl":"Możesz powtórzyć?","ipa":"ˈmɔʐɛʂ pɔfˈtuʐɨtɕ","es":"¿Puedes repetir?","n":"Formal: «Czy może pan/pani powtórzyć?»."},
{"pl":"Mów wolniej, proszę.","ipa":"muf ˈvɔlɲɛj ˈprɔʂɛ","es":"Habla más despacio, por favor.","n":"Formal: «Proszę mówić wolniej»."},
{"pl":"Co to znaczy?","ipa":"tsɔ tɔ ˈznatʂɨ","es":"¿Qué significa eso?"},
{"pl":"Jak się mówi po polsku…?","ipa":"jak ɕɛ ˈmuvi pɔ ˈpɔlsku","es":"¿Cómo se dice en polaco…?"},
{"pl":"Jak to się pisze?","ipa":"jak tɔ ɕɛ ˈpiʂɛ","es":"¿Cómo se escribe?"},
{"pl":"Czy mówisz po angielsku?","ipa":"tʂɨ ˈmuviʂ pɔ aŋˈɡʲɛlsku","es":"¿Hablas inglés?"},
{"pl":"Mam pytanie.","ipa":"mam pɨˈtaɲɛ","es":"Tengo una pregunta."},
{"pl":"Możesz mi pomóc?","ipa":"ˈmɔʐɛʂ mi ˈpɔmuts","es":"¿Me puedes ayudar?"},
{"pl":"Chwileczkę.","ipa":"xfiˈlɛtʂkɛ","es":"Un momentito."},
{"pl":"Jasne!","ipa":"ˈjasnɛ","es":"¡Claro!"},
{"pl":"Oczywiście.","ipa":"ɔtʂɨˈviɕtɕɛ","es":"Por supuesto."},
{"pl":"Naprawdę?","ipa":"naˈpravdɛ","es":"¿De verdad?"},
{"pl":"No!","ipa":"nɔ","es":"¡Sí! / ¡Ajá!","n":"¡Ojo! En polaco coloquial «no» significa «sí». «Nie» es «no»."},
{"pl":"Racja.","ipa":"ˈratsja","es":"Tienes razón."},
{"pl":"Zgadzam się.","ipa":"ˈzɡadzam ɕɛ","es":"Estoy de acuerdo."},
{"pl":"Nie szkodzi.","ipa":"ɲɛ ˈʂkɔdʑi","es":"No pasa nada.","n":"Respuesta típica a «Przepraszam»."},
{"pl":"Nie ma problemu.","ipa":"ɲɛ ma prɔˈblɛmu","es":"No hay problema."}
],
"ctx":[
{"w":"Ola","pl":"Masz czas jutro?","es":"¿Tienes tiempo mañana?"},
{"w":"Tú","pl":"Przepraszam, nie rozumiem. Mów wolniej, proszę.","es":"Perdón, no entiendo. Habla más despacio, por favor."},
{"w":"Ola","pl":"Masz… czas… jutro?","es":"¿Tienes… tiempo… mañana?"},
{"w":"Tú","pl":"Aaa, rozumiem! Tak, mam czas. Co to znaczy „kawiarnia”?","es":"¡Ahh, entiendo! Sí, tengo tiempo. ¿Qué significa «kawiarnia»?"},
{"w":"Ola","pl":"To jest miejsce, gdzie pijemy kawę.","es":"Es un lugar donde tomamos café."},
{"w":"Tú","pl":"Jasne! To idziemy do kawiarni!","es":"¡Claro! ¡Entonces vamos a la cafetería!"}
]},

